{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/(.*\\.(jpg|jpeg|png|gif|svg|ico|css|js|ico|txt))",
      "destination": "/$1"
    }
  ]
}
